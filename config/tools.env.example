# ============================================================================
# 环境变量模板
#
# 用法：复制为 tools.env 或在自己的 shell 中导出；不要提交填充后的真实路径。
#   cp config/tools.env.example config/tools.env
#   set -a; . config/tools.env; set +a
#
# 所有值都是占位符，脚本不会在仓库内寻找 UE 工程或源数据。
# 大多数脚本可从仓库根目录直接运行；只有需要 UE / RenderDoc 的脚本才读取
# 下面这些变量。
# ============================================================================

# 工作区根目录（包含 data/、shots/ 等本地源数据；仓库本身不含这些目录）
MC_WORKSPACE=.

# UE 5.8 工程根目录（含 .uproject 的目录）
UE_PROJECT=/path/to/UE_5.8_project

# UE_MCP_Bridge 使用的 ws 模块入口；也可在仓库根目录 npm i ws 后改用
# ./node_modules/ws/wrapper.mjs
UE_MCP_WS=/path/to/node_modules/ws/wrapper.mjs

# RenderDoc 安装目录（脚本会在此目录下寻找 qrenderdoc / renderdoccmd）
RENDERDOC_DIR=/path/to/RenderDoc

# 工具输出目录（LUT、对比图、中间 RT 等）
MC_OUT=./out
